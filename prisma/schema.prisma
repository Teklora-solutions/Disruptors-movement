generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  MOVEMENT_ADMIN
  ORG_ADMIN
  ORG_EDITOR
  MEMBER
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  providerId    String?
  provider      String?
  platformRole  PlatformRole    @default(MEMBER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  memberProfile MemberProfile?
  orgMembership OrgMembership[]
  consents      Consent[]
  payments      Payment[]
  registrations Registration[]
  applications  Application[]
}

model MemberProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  county            String?
  interests         String[]
  skills            String[]
  consentMarketing  Boolean  @default(false)
  consentDataExport Boolean  @default(false)
  consentGivenAt    DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
}

model Organisation {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  websiteUrl     String?
  logoUrl        String?
  rssUrl         String?
  icalUrl        String?
  lastIngestAt   DateTime?
  lastIngestError String?
  deletedAt      DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orgMemberships OrgMembership[]
  events         Event[]
  fellowships    Fellowship[]
  activities     Activity[]
}

model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  role           PlatformRole
  joinedAt       DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([userId, organisationId, role])
}

model Event {
  id             String        @id @default(cuid())
  organisationId String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  onlineUrl      String?
  sourceUrl      String?
  sourceHash     String?       @unique
  imageUrl       String?
  capacity       Int?
  priceKes       Int           @default(0)
  status         EventStatus   @default(DRAFT)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  registrations  Registration[]

  @@index([organisationId, deletedAt])
  // Trigram indexes for the public search (ILIKE '%term%' on title/description),
  // which otherwise scans every event. pg_trgm is enabled by the migration.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Fellowship {
  id             String        @id @default(cuid())
  organisationId String
  title          String
  description    String?
  opensAt        DateTime
  closesAt       DateTime
  requirements   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  applications   Application[]
}

model Activity {
  id             String       @id @default(cuid())
  organisationId String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model Application {
  id           String     @id @default(cuid())
  fellowshipId String
  userId       String
  answersJson  Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  fellowship   Fellowship @relation(fields: [fellowshipId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([fellowshipId, userId])
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  userId        String
  status        RegistrationStatus @default(PENDING_PAYMENT)
  reservedUntil DateTime?
  ticketCode    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  event         Event              @relation(fields: [eventId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  payment       Payment?

  @@unique([eventId, userId])
}

model Payment {
  id             String        @id @default(cuid())
  provider       String
  providerRef    String        @unique
  amountKes      Int
  status         PaymentStatus @default(PENDING)
  receiptUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  registrationId String?       @unique
  user           User          @relation(fields: [userId], references: [id])
  registration   Registration? @relation(fields: [registrationId], references: [id])
}

model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  payloadJson Json
  receivedAt  DateTime @default(now())

  @@unique([provider, externalId])
}

model Consent {
  id        String    @id @default(cuid())
  userId    String
  purpose   String
  givenAt   DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  tableName     String
  recordId      String
  performedById String
  performedAt   DateTime @default(now())
  before        Json?
  after         Json?

  @@index([tableName, recordId])
}
