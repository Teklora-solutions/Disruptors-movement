# Example environment variables for Disruptors Movement
# Copy to .env and fill in real values

# PostgreSQL connection string (user:password@host:port/dbname)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disruptors?schema=public

# Redis connection URL
REDIS_URL=redis://localhost:6379

# JWT secret for API verification (if used locally)
JWT_SECRET=your-secret-here

# JWKS URI for external auth provider (e.g., https://your-domain/.well-known/jwks.json)
AUTH_JWKS_URI=https://your-auth-provider/.well-known/jwks.json
JWT_SECRET=your-secret-here

# M-Pesa Daraja credentials (sandbox)
MPESA_CONSUMER_KEY=your-key
MPESA_CONSUMER_SECRET=your-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey

# Africa's Talking API key
AFRICASTALKING_API_KEY=your-key

# Resend API key (email)
RESEND_API_KEY=your-key

