# Environment variables for Disruptors Movement
# Copy to .env and fill in real values:   cp .env.example .env && chmod 600 .env
#
# Generating secrets: each value marked "generate" has the command to make it.
# Run the command, paste the output. Never reuse a value between environments.

# ---- Production (docker-compose.yml) ----
# The tunnel's public hostname: bare host, no scheme, path or port.
PUBLIC_HOSTNAME=disruptors.example.com
# Used by the db container and to build DATABASE_URL for the api.
POSTGRES_USER=disruptors
# generate:  openssl rand -hex 32
#   Hex on purpose: the password goes into a URL, and hex has no @ : / ? # %.
#   Only read when ./data/postgres is first initialised; see deploy/README.md to rotate.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=disruptors

# The tunnel token is NOT here. It goes in cloudflared.env (see cloudflared.env.example).

# ---- Local development (docker-compose.dev.yml) ----
# In production, compose overrides DATABASE_URL and REDIS_URL with in-network values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disruptors?schema=public
REDIS_URL=redis://localhost:6379

# ---- Shared ----
# REQUIRED. Signs sign-in sessions and the links in verification and reset emails.
# The API will not start without it. Changing it signs everyone out and voids
# any links already sent.
# generate:  openssl rand -base64 48
#   (no openssl?  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=your-secret-here

# New members must open the link in their confirmation email before they can
# sign in. Set to false to let them in straight away.
EMAIL_VERIFICATION_REQUIRED=true

# ---- Email: Gmail SMTP ----
# Sends confirmation, welcome and password-reset emails. Leave SMTP_HOST empty
# in development: emails (with their links) are printed in the API log instead.
#
# SMTP_PASS is NOT your Gmail password. It is a 16-character App Password:
#   1. Turn on 2-Step Verification:  myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:       myaccount.google.com/apppasswords  (name it "Disruptors")
#   3. Paste it here without spaces.
# Limits: about 500 recipients a day on a free Gmail account, 2,000 on Google Workspace.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
# The sender people see. Gmail only sends as SMTP_USER or an alias added under
# Gmail Settings > Accounts > "Send mail as"; anything else is rewritten.
MAIL_FROM="Disruptors Movement <you@gmail.com>"

# M-Pesa Daraja credentials. Issued by Safaricom, not generated:
#   developer.safaricom.co.ke -> My Apps (key/secret); the passkey comes with the shortcode.
#   174379 is the public sandbox shortcode; replace it for production.
MPESA_CONSUMER_KEY=your-key
MPESA_CONSUMER_SECRET=your-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey

# Africa's Talking API key. Issued by the dashboard: account.africastalking.com -> Settings -> API Key
AFRICASTALKING_API_KEY=your-key

